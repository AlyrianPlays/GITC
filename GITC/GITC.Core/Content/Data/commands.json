[
  // TIM commands. Behaviour is attached in code by name (Commands/BuiltinCommands.cs).
  // A command listed here with no handler answers "is not available yet". scope: anywhere | mission | overworld.
  { "name": "echo",      "description": "Print text back to the console" },
  { "name": "help",      "description": "List the commands you can use" },
  { "name": "clear",     "description": "Clear the console" },
  { "name": "listdir",   "aliases": [ "ls", "dir" ], "description": "List the files in the current directory" },
  { "name": "changedir", "aliases": [ "cd" ],        "description": "Change the current directory" },
  { "name": "read",      "aliases": [ "cat" ],       "description": "Display a file" },
  // Vital Monitor commands (mission only): one vital, one direction each; each has a cooldown in seconds
  { "name": "calm",      "scope": "mission", "cooldownSeconds": 8, "description": "Lower the agent's heart rate" },
  { "name": "reassure",  "scope": "mission", "cooldownSeconds": 8, "description": "Raise the agent's sanity" },
  { "name": "stimulate", "scope": "mission", "cooldownSeconds": 8, "description": "Raise the agent's heart rate" },
  { "name": "warm",      "scope": "mission", "cooldownSeconds": 6, "description": "Raise the agent's body temperature" },
  { "name": "cool",      "scope": "mission", "cooldownSeconds": 6, "description": "Lower the agent's body temperature" },
  // Hidden command, declared but not implemented yet (shows the friendly message)
  { "name": "whispers",  "hidden": true, "description": "..." }
]
